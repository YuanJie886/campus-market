# 本文件是模板，复制为 deploy/.env 后必须逐项填写。
# 所有留空的值都没有默认值：不填就启动失败，这是刻意设计，不是配置遗漏。
# deploy/.env 已被 .gitignore 忽略，绝不要把真实密钥提交进仓库。

# 数据库密码。建议只使用字母数字，避免 DATABASE_URL 特殊字符转义问题。
# 留空，必须自行生成：
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# JWT 签名密钥 —— 留空，必须自行生成。
#
#   ⚠️ 禁止填写本文件里的任何示例值或任何在网上/仓库里能查到的字符串。
#      本模板刻意不提供可用默认值：历史上这里放过一个 42 字节的占位串，
#      它长度达标、能通过后端的 32 字节校验，导致「cp .env.example .env
#      忘了改」就会让生产环境使用一个全网公开的签名密钥启动。
#
#   ⚠️ 禁止把生成出来的真实密钥提交到 Git，也不要贴进聊天、工单或截图。
#
#   ⚠️ 每个部署环境（开发 / 预发 / 生产）必须各自独立生成，不得复用同一把。
#      泄露任何一个环境的密钥，都不应影响其他环境。
#
#   要求至少 32 字节；下面的命令生成 48 字节（Base64 后 64 字符），留有余量。
#   macOS 与 Linux 通用：
#
#       openssl rand -base64 48
#
#   把命令输出粘贴到等号右边即可。请勿用重定向直接写入本文件或 .env，
#   以免覆盖你已经填好的其他配置。
#
#   轮换密钥会使所有已签发的 access token 立即失效，用户需要重新登录；
#   refresh token 走独立随机串机制，不受影响。
JWT_SECRET=

WEB_ORIGIN=http://localhost:8080

# 刷新 Cookie 是否带 Secure 标记。没有默认值，必须显式填写。
#   HTTPS 部署：true（唯一正确的取值）
#   本地 http 调试：false
# 若 WEB_ORIGIN 是 https:// 而这里填 false，后端会直接拒绝启动——
# 那种组合意味着长期凭据会在明文连接上发送，只可能是配置遗漏。
SECURE_COOKIES=false

# Flyway 基线开关 —— 绝大多数情况下保持 false。
#
# false（默认）：
#   - 全新空库：Flyway 自动执行 V1__initial_schema.sql 建表，这是正常路径。
#   - 已被 Flyway 管理的库：校验通过后继续，不重复迁移。
#   - 非空但没有 flyway_schema_history 的库：拒绝启动。这是刻意设置的安全闸，
#     防止把任意未知数据库误当作本项目的旧库接管。
#
# true（仅限一次性使用）：
#   只适用于「由旧版 DatabaseInitializer 建好结构、已有真实业务数据、
#   但没有 flyway_schema_history」的数据库首次接管。
#
#   开启前必须完成：
#     1. 完整备份数据库，并实际验证过备份可恢复；
#     2. 用 V1 在测试环境建一个新库，与旧库做结构 diff，确认一致；
#     3. 用生产备份在测试环境完整演练一遍接管流程。
#
#   注意：baseline 不会校验旧库结构是否真的与 V1 相同，它只是写一行
#   「假定此库已是版本 1」的记录并跳过 V1。结构若有差异会被静默接受。
#
#   接管成功后必须立即改回 false 并重启确认。不得长期保持 true。
#
# 详见 campus-market-backend/docs/database-migrations.md
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
