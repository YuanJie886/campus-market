{
  "name": "campus-market",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "校园闲置集市 · React + Spring Boot + PostgreSQL",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:legacy",
    "preview": "vite preview --port 4173",
    "api:build": "mvn -f ../campus-market-backend -DskipTests package",
    "api:start": "mvn -f ../campus-market-backend spring-boot:run",
    "db:migrate": "echo 'Spring Boot 启动时会自动初始化数据库结构'",
    "test:api": "mvn -f ../campus-market-backend test",
    "test:legacy": "vite-node qa-tests/utils.test.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.20",
    "@mui/material": "^5.15.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "prettier": "^3.9.7",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^3.2.7"
  }
}
